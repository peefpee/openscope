<dialog id="session-menu" aria-labelledby="session-title">
    <div class="menu-backdrop" aria-hidden="true">
        <canvas id="session-menu-radar-canvas" class="menu-backdrop__canvas"></canvas>
        <div class="menu-backdrop__fallback"></div>
        <div class="menu-backdrop__vignette"></div>
    </div>

    <main class="menu-shell">
        <header class="menu-topbar">
            <div class="menu-brand">
                <svg class="menu-brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                    <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5"/>
                    <circle cx="16" cy="16" r="7.5" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.2"/>
                    <path d="M16 16L25.5 8.5" stroke="#91E8BC" stroke-width="1.8" stroke-linecap="round"/>
                    <circle cx="16" cy="16" r="2" fill="#91E8BC"/>
                </svg>
                <h1 id="session-title" class="menu-topbar__title">openScope</h1>
            </div>
            <div class="menu-topbar__meta">
                <span class="menu-topbar__badge">ATC SIMULATOR</span>
                <span class="menu-topbar__version">v{{version}}</span>
            </div>
        </header>

        <p id="session-error" class="menu-error" role="alert"></p>

        <section data-page="home">
            <div class="menu-hero">
                <div class="menu-hero__content">
                    <p class="menu-eyebrow">AIR TRAFFIC CONTROL &amp; APPROACH RADAR</p>
                    <h2 class="menu-hero__headline">openScope</h2>
                    <p class="menu-hero__subtitle">
                        Realistic terminal and approach radar simulation with Australian CIFP procedures,
                        runway flow control, and voice readbacks.
                    </p>
                    <div class="menu-hero__actions">
                        <button type="button" class="menu-btn-primary menu-btn-lg" data-action="play">
                            <svg class="menu-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.5 4.8a.75.75 0 0 1 1.14-.64l8.25 5.2a.75.75 0 0 1 0 1.28l-8.25 5.2A.75.75 0 0 1 6.5 15.2V4.8Z"/>
                            </svg>
                            <span>Play</span>
                        </button>
                        <button type="button" class="menu-btn-secondary menu-btn-lg" data-action="settings">
                            <svg class="menu-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <circle cx="10" cy="10" r="2.75"/>
                                <path d="M10 2.5v2M10 15.5v2M3.5 10h2M14.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" stroke-linecap="round"/>
                            </svg>
                            <span>Settings</span>
                        </button>
                    </div>
                    <div class="menu-hero__specs">
                        <span class="menu-spec-chip">v{{version}}</span>
                        <span class="menu-spec-chip">vatSys-Inspired Scope</span>
                        <span class="menu-spec-chip">Australian CIFP / OpenAir</span>
                    </div>
                </div>
                <div class="menu-hero__radar-space" aria-hidden="true"></div>
            </div>
        </section>

        <section data-page="modes" hidden>
            <div class="menu-page-header">
                <p class="menu-eyebrow">NEW SESSION</p>
                <p class="menu-page-lead">Choose a bundled sector or import Australian CIFP navigation data.</p>
            </div>
            <div class="menu-mode-grid">
                <button type="button" class="menu-mode-card" data-action="classic">
                    <div class="menu-mode-card__art" aria-hidden="true">
                        <svg viewBox="0 0 220 110" fill="none">
                            <circle cx="110" cy="55" r="44" stroke="#8FC6D3" stroke-opacity="0.22" stroke-dasharray="3 3"/>
                            <circle cx="110" cy="55" r="26" stroke="#8FC6D3" stroke-opacity="0.28"/>
                            <line x1="76" y1="68" x2="144" y2="42" stroke="#91E8BC" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="94" y1="32" x2="126" y2="78" stroke="#8FC6D3" stroke-opacity="0.65" stroke-width="1.8" stroke-linecap="round"/>
                            <circle cx="144" cy="42" r="3" fill="#91E8BC"/>
                            <circle cx="80" cy="40" r="2.5" fill="#F0F8F7"/>
                            <path d="M80 40L64 33" stroke="#91E8BC" stroke-opacity="0.55" stroke-width="1.5"/>
                        </svg>
                    </div>
                    <div class="menu-mode-card__body">
                        <span class="menu-mode-card__tag">BUNDLED AIRPORTS</span>
                        <strong class="menu-mode-card__title">Classic</strong>
                        <small class="menu-mode-card__desc">Bundled airports with prepared procedures, runway flows, and airspace.</small>
                    </div>
                    <span class="menu-mode-card__cta">Select airport →</span>
                </button>

                <button type="button" class="menu-mode-card" data-action="custom">
                    <div class="menu-mode-card__art" aria-hidden="true">
                        <svg viewBox="0 0 220 110" fill="none">
                            <rect x="44" y="20" width="132" height="70" rx="6" stroke="#8FC6D3" stroke-opacity="0.32" stroke-dasharray="4 3"/>
                            <path d="M110 34v28m0 0-10-10m10 10 10-10" stroke="#91E8BC" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M78 72h64" stroke="#8FC6D3" stroke-opacity="0.6" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="62" cy="36" r="2.5" fill="#91E8BC"/>
                            <circle cx="158" cy="74" r="2.5" fill="#8FC6D3"/>
                        </svg>
                    </div>
                    <div class="menu-mode-card__body">
                        <span class="menu-mode-card__tag">CIFP / OPENAIR</span>
                        <strong class="menu-mode-card__title">Custom</strong>
                        <small class="menu-mode-card__desc">Import an Australian CIFP airport (.dat), fixes, MSA, airspace, or cached sector.</small>
                    </div>
                    <span class="menu-mode-card__cta">Open importer →</span>
                </button>
            </div>
            <div class="menu-page-footer">
                <button type="button" class="menu-btn-ghost" data-action="home">← Back</button>
            </div>
        </section>

        <section data-page="classic" hidden>
            <div class="menu-classic-layout">
                <div class="menu-card menu-classic-list-pane">
                    <label class="menu-field menu-search-field" for="session-airport-search">
                        <span>Filter airports</span>
                        <input id="session-airport-search" type="search" placeholder="Search ICAO or name">
                    </label>
                    <div id="session-airport-cards" class="menu-airport-cards" role="listbox" aria-label="Bundled airports"></div>
                    <label class="menu-field menu-classic-select-wrap" for="session-airport">
                        <span>Airport</span>
                        <select id="session-airport"></select>
                    </label>
                </div>

                <div class="menu-card menu-classic-preview-pane">
                    <div class="menu-radar-preview" aria-hidden="true">
                        <svg id="session-classic-preview-svg" viewBox="0 0 260 160" fill="none">
                            <circle cx="130" cy="80" r="64" stroke="#8FC6D3" stroke-opacity="0.16" stroke-dasharray="3 3"/>
                            <circle cx="130" cy="80" r="38" stroke="#8FC6D3" stroke-opacity="0.24"/>
                            <circle cx="130" cy="80" r="14" stroke="#91E8BC" stroke-opacity="0.35"/>
                            <line x1="130" y1="12" x2="130" y2="148" stroke="#8FC6D3" stroke-opacity="0.12"/>
                            <line x1="62" y1="80" x2="198" y2="80" stroke="#8FC6D3" stroke-opacity="0.12"/>
                        </svg>
                    </div>
                    <div class="menu-classic-meta-box">
                        <p class="menu-eyebrow">SELECTED SECTOR</p>
                        <p id="session-airport-meta" class="menu-classic-meta" role="status"></p>
                    </div>
                    <div class="menu-page-actions">
                        <button type="button" class="menu-btn-primary" data-action="configure">Configure session →</button>
                        <button type="button" class="menu-btn-ghost" data-action="play">← Back</button>
                    </div>
                </div>
            </div>
        </section>

        <section data-page="setup" hidden>
            <div class="menu-setup-layout">
                <div class="menu-setup-main">
                    <fieldset id="session-setup-traffic" class="menu-card">
                        <legend>Traffic</legend>
                        <div class="menu-toggle-grid">
                            <label class="menu-toggle">
                                <input id="session-arrivals" type="checkbox" checked>
                                <span>IFR arrivals</span>
                            </label>
                            <label class="menu-toggle">
                                <input id="session-departures" type="checkbox">
                                <span>IFR departures</span>
                            </label>
                            <label class="menu-toggle">
                                <input id="session-vfr" type="checkbox">
                                <span>VFR traffic</span>
                            </label>
                        </div>
                        <div class="menu-field-row">
                            <label class="menu-field" for="session-rate">
                                <span>IFR traffic rate</span>
                                <select id="session-rate">
                                    <option value="0.5">0.5×</option>
                                    <option selected value="1">1× airport rate</option>
                                    <option value="1.5">1.5×</option>
                                    <option value="2">2×</option>
                                </select>
                            </label>
                            <label class="menu-field" for="session-mix">
                                <span>IFR arrival share</span>
                                <select id="session-mix">
                                    <option value="">Airport mix</option>
                                    <option value="0.25">25%</option>
                                    <option value="0.5">50%</option>
                                    <option value="0.75">75%</option>
                                </select>
                            </label>
                        </div>
                    </fieldset>

                    <div class="menu-card">
                        <h2 class="menu-card__title">Runway operations</h2>
                        <label class="menu-field" for="session-runways">
                            <span>Runway flow</span>
                            <select id="session-runways"></select>
                        </label>
                        <div id="session-setup-runway-diagram" class="menu-runway-diagram" aria-hidden="true"></div>
                    </div>

                    <details class="menu-card menu-frequencies-card" open>
                        <summary>Controller frequencies</summary>
                        <div id="session-frequencies" class="menu-frequencies-grid"></div>
                    </details>
                </div>

                <aside class="menu-setup-rail">
                    <div class="menu-card menu-summary-card">
                        <h2 class="menu-card__title">Session summary</h2>
                        <dl id="session-setup-summary" class="menu-summary-list">
                            <div><dt>Sector</dt><dd data-summary="airport">Selected airport</dd></div>
                            <div><dt>Traffic</dt><dd data-summary="traffic">IFR arrivals</dd></div>
                            <div><dt>Rate</dt><dd data-summary="rate">1× airport rate</dd></div>
                            <div><dt>Runway flow</dt><dd data-summary="runway">Airport default</dd></div>
                        </dl>
                        <div class="menu-summary-actions">
                            <button type="button" class="menu-btn-primary menu-btn-lg" data-action="start">Start session</button>
                            <button type="button" class="menu-btn-ghost" data-action="selection">← Back</button>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section data-page="loading" hidden>
            <div class="menu-card menu-loading-card">
                <div class="menu-loading-spinner" aria-hidden="true">
                    <svg viewBox="0 0 64 64" fill="none">
                        <circle cx="32" cy="32" r="28" stroke="#8FC6D3" stroke-opacity="0.22" stroke-width="2"/>
                        <path d="M32 4a28 28 0 0 1 28 28" stroke="#91E8BC" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="32" cy="32" r="4" fill="#91E8BC"/>
                    </svg>
                </div>
                <p role="status" class="menu-loading-card__status">Preparing radar and traffic…</p>
                <p class="menu-loading-card__sub">Loading airspace geometry, navigation fixes, and flight strips</p>
                <button type="button" class="menu-btn-ghost" data-action="cancel">Cancel</button>
            </div>
        </section>

        <section data-page="pause" hidden>
            <div class="menu-card menu-modal-card">
                <p class="menu-eyebrow">SESSION PAUSED</p>
                <p class="menu-modal-card__message">Simulation clock and scoring are suspended.</p>
                <div class="menu-modal-actions">
                    <button type="button" class="menu-btn-primary menu-btn-lg" data-action="resume">Resume</button>
                    <button type="button" class="menu-btn-secondary" data-action="settings">Settings</button>
                    <button type="button" class="menu-btn-danger" data-action="confirm">Exit</button>
                </div>
            </div>
        </section>

        <section data-page="confirm" hidden>
            <div class="menu-card menu-modal-card menu-modal-card--warning">
                <p class="menu-eyebrow">EXIT SESSION</p>
                <p class="menu-modal-card__message">Current traffic and clearances will be lost.</p>
                <div class="menu-modal-actions menu-modal-actions--row">
                    <button type="button" class="menu-btn-secondary" data-action="pause">Cancel</button>
                    <button type="button" class="menu-btn-danger" data-action="exit">Exit to main menu</button>
                </div>
            </div>
        </section>

        <section data-page="settings" hidden>
            <div class="menu-settings-layout">
                <div class="menu-card">
                    <h2 class="menu-card__title">General</h2>
                    <label class="menu-field">
                        <span>Language</span>
                        <select disabled><option>English (Australia)</option></select>
                    </label>
                </div>

                <fieldset class="menu-card">
                    <legend>Aircraft speech</legend>
                    <label class="menu-toggle">
                        <input type="checkbox" id="voice-enabled">
                        <span>Enable radio speech</span>
                    </label>
                    <div class="menu-field-row">
                        <label class="menu-field" for="voice-choice">
                            <span>Voice</span>
                            <select id="voice-choice"></select>
                        </label>
                        <div class="menu-field menu-field--action">
                            <span>Audio check</span>
                            <button type="button" class="menu-btn-secondary" data-action="testVoice">Test voice</button>
                        </div>
                    </div>
                    <div class="menu-field-row">
                        <label class="menu-field menu-range-field" for="voice-volume">
                            <span>Volume <output class="menu-range-value" data-for="voice-volume"></output></span>
                            <input id="voice-volume" type="range" min="0" max="1" step=".05">
                        </label>
                        <label class="menu-field menu-range-field" for="voice-rate">
                            <span>Speech rate <output class="menu-range-value" data-for="voice-rate"></output></span>
                            <input id="voice-rate" type="range" min=".5" max="2" step=".1">
                        </label>
                    </div>
                </fieldset>

                <details class="menu-card menu-radar-prefs-card" open>
                    <summary>Radar and controls</summary>
                    <div id="radar-preferences" class="menu-radar-prefs-grid"></div>
                </details>

                <div class="menu-settings-footer">
                    <button type="button" class="menu-btn-secondary" data-action="fullscreen">Toggle fullscreen</button>
                    <button type="button" class="menu-btn-danger" data-action="reset">Reset client settings</button>
                    <button type="button" class="menu-btn-primary" data-action="settingsBack">Back</button>
                </div>
            </div>
        </section>

        <section data-page="reset" hidden>
            <div class="menu-card menu-modal-card menu-modal-card--warning">
                <p class="menu-eyebrow">RESTORE DEFAULTS</p>
                <p class="menu-modal-card__message">Restore default speech, radar and control preferences?</p>
                <div class="menu-modal-actions menu-modal-actions--row">
                    <button type="button" class="menu-btn-secondary" data-action="settings">Cancel</button>
                    <button type="button" class="menu-btn-danger" data-action="resetYes">Restore defaults</button>
                </div>
            </div>
        </section>
    </main>
</dialog>
