<dialog id="dat-import" aria-labelledby="dat-import-title">
    <header>
        <h2 id="dat-import-title">Import airport data</h2>
        <form method="dialog"><button type="submit" aria-label="Close import dialog">&times;</button></form>
    </header>
    <div class="dat-cached" hidden>
        <label for="dat-cached-airport">Saved airport</label>
        <select id="dat-cached-airport"></select>
    </div>
    <label for="dat-airport-file">Airport file <small>X-Plane CIFP · ICAO.dat</small></label>
    <input id="dat-airport-file" type="file" accept=".dat">
    <label for="dat-waypoint-file">Waypoint coordinates <small>Optional · earth_fix.dat</small></label>
    <input id="dat-waypoint-file" type="file" accept=".dat">
    <small class="dat-fix-source"></small>
    <label for="dat-msa-file">Minimum sector altitudes <small>Optional · earth_msa.dat</small></label>
    <input id="dat-msa-file" type="file" accept=".dat">
    <small class="dat-msa-source"></small>
    <label for="dat-airspace-file">Australian controlled airspace <small>Optional · airspaces/airspace.txt</small></label>
    <input id="dat-airspace-file" type="file" accept=".txt"><div class="dat-airspace-source"></div>
    <p class="dat-cache-status" role="status"></p>
    <p class="dat-status" role="status" aria-live="polite"></p>
    <div class="dat-results nice-scrollbar"></div>
    <footer hidden>
        <div class="dat-spoken-name" hidden>
            <label for="dat-spoken-name">Airport name for radio calls</label>
            <input id="dat-spoken-name" type="text" maxlength="80" placeholder="e.g. Hobart">
        </div>
        <div class="dat-controller-names" hidden>
            <label for="dat-approach-callsign">Approach callsign</label>
            <input id="dat-approach-callsign" type="text" maxlength="24" placeholder="e.g. ML_APP">
            <label for="dat-approach-frequency">Approach frequency</label>
            <input id="dat-approach-frequency" type="text" maxlength="12" placeholder="e.g. 132.000">
            <label for="dat-approach-radio-name">Approach radio name</label>
            <input id="dat-approach-radio-name" type="text" maxlength="80" placeholder="e.g. Melbourne Approach">
            <label for="dat-departure-radio-name">Departure radio name</label>
            <input id="dat-departure-radio-name" type="text" maxlength="80" placeholder="e.g. Melbourne Departures">
            <label for="dat-tower-callsign">Tower callsign</label>
            <input id="dat-tower-callsign" type="text" maxlength="24" placeholder="e.g. ML_TWR">
            <label for="dat-tower-frequency">Tower frequency</label>
            <input id="dat-tower-frequency" type="text" maxlength="12" placeholder="e.g. 120.500">
            <label for="dat-tower-radio-name">Tower radio name</label>
            <input id="dat-tower-radio-name" type="text" maxlength="80" placeholder="e.g. Melbourne Tower">
            <label for="dat-centre-select">Centre airspace</label>
            <select id="dat-centre-select">
                <option value="YMMM">YMMM — Melbourne Centre</option>
                <option value="YBBB">YBBB — Brisbane Centre</option>
            </select>
            <label for="dat-centre-frequency">Centre frequency</label>
            <input id="dat-centre-frequency" type="text" maxlength="12" placeholder="Simulated fallback if blank">
            <label for="dat-centre-radio-name">Centre radio name</label>
            <input id="dat-centre-radio-name" type="text" maxlength="80" placeholder="e.g. Melbourne Centre">
        </div>
        <div class="dat-terrain-section" hidden>
            <label><input id="dat-terrain-auto" type="checkbox" checked> Automatically generate terrain</label>
            <label for="dat-terrain-provider">Terrain source</label>
            <select id="dat-terrain-provider">
                <option value="auto">Auto (GA SRTM / Copernicus DEM)</option>
                <option value="open-meteo">Open-Meteo (Copernicus GLO-90)</option>
            </select>
            <label for="dat-terrain-coverage">Terrain coverage</label>
            <select id="dat-terrain-coverage">
                <option value="40">40 NM</option>
                <option value="60" selected>60 NM</option>
                <option value="80">80 NM</option>
                <option value="auto">Auto (airspace extent)</option>
            </select>
            <label for="dat-terrain-file">Manual terrain GeoJSON <small>Optional · .geojson</small></label>
            <input id="dat-terrain-file" type="file" accept=".geojson,.json">
            <p class="dat-terrain-status" role="status"></p>
            <div class="dat-terrain-actions">
                <button type="button" class="dat-terrain-regen">Regenerate terrain</button>
                <button type="button" class="dat-terrain-clear">Clear terrain</button>
            </div>
        </div>
        <p>Opening this scope starts a new session with simulated arrivals and departures in a 40 NM practice sector. Use the SID and STAR radar controls to display flyable procedures.</p>
        <button type="button" class="dat-open">Open imported scope</button>
    </footer>
</dialog>
